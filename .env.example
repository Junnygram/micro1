# ZaraSourcing Environment Configuration
# Copy this file to .env and configure your keys

# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 8080)
PORT=8080

# AWS S3 Configuration for Resume Storage
# In production, resumes are uploaded to this S3 bucket.
# For local development, files are stored in data/resumes/ and the S3 URL is simulated.
AWS_S3_BUCKET=zarasourcing-resumes-junnygram
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=

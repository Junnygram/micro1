# ZaraSourcing Environment Configuration
# Copy this file to .env and configure your keys

# Get your Gemini API key from https://aistudio.google.com/
# Use a fresh key — leaked keys return HTTP 403 and block all agent runs.
GEMINI_API_KEY=your_gemini_api_key_here

# Server Port (default: 8080)
PORT=8080

# Frontend API URL — set at BUILD time on Railway (frontend service)
NEXT_PUBLIC_API_URL=http://localhost:8080

# LLM Provider: bedrock (default when AWS creds set) or gemini
LLM_PROVIDER=bedrock

# AWS — Bedrock (Claude), Polly (voice), S3 (files)
# Set these before AWS access expires — agent + interviews use Bedrock first
AWS_S3_BUCKET=zarasourcing-resumes-junnygram
AWS_S3_REGION=us-east-1
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
OPENAI_API_KEY=
